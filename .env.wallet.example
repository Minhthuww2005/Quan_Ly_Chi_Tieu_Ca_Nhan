# Copy to .env.wallet. This file does not contain credentials.
ConnectionStrings__Database=Host=YOUR_NEON_HOST;Database=YOUR_DATABASE;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=VerifyFull
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Google__ClientId=
Vnpay__TmnCode=
Vnpay__HashSecret=
Vnpay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Vnpay__ReturnUrl=http://127.0.0.1:5174/payments/return
# Configure the externally reachable IPN URL with VNPay: /api/payments/vnpay/ipn
