FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/WalletFunding.Api/WalletFunding.Api.csproj src/WalletFunding.Api/
RUN dotnet restore src/WalletFunding.Api/WalletFunding.Api.csproj
COPY src/WalletFunding.Api/ src/WalletFunding.Api/
RUN dotnet publish src/WalletFunding.Api/WalletFunding.Api.csproj -c Release --no-restore -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080 ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["dotnet", "WalletFunding.Api.dll"]
